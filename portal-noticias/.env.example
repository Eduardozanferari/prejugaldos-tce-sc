# Copie para .env e preencha. O arquivo .env nunca vai para o git.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Segredo da sessão (cookie de login). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_SEGREDO_SESSAO=
# 1 quando o portal estiver atrás de HTTPS (recomendado)
PORTAL_HTTPS=1
